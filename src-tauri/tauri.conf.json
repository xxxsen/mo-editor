{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "心灵终结规则编辑器",
  "version": "0.1.1",
  "identifier": "local.mentalomega.ruleseditor",
  "build": { "frontendDist": "../desktop-dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "心灵终结规则编辑器", "width": 1440, "height": 950, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"] }
}
